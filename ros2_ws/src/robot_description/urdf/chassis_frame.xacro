<?xml version="1.0"?>
<!-- =========================================================================
     chassis_frame.xacro
     Macro vẽ KHUNG NHÔM ĐỊNH HÌNH HỞ (aluminium extrusion cage) cho VISUAL.
     Ghép từ nhiều thanh box mảnh thay vì 1 khối hộp đặc, để nhìn giống xe thật.
     Tọa độ gốc = tâm base_link. Khung trải:
        X: -L/2 .. +L/2   (L = base_length)
        Y: -W/2 .. +W/2   (W = base_width)
        Z: -H/2 .. +H/2   (H = base_height)
     Dùng biến profile_size (p) làm độ dày thanh.
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 1 thanh nhôm: hộp dài, đặt tại (x,y,z), kích thước (sx,sy,sz) -->
  <xacro:macro name="beam" params="x y z sx sy sz">
    <visual>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
      <material name="grey"/>
    </visual>
  </xacro:macro>

  <!-- Vẽ 1 khung chữ nhật nằm ngang (4 thanh) ở độ cao z cho trước.
       2 thanh chạy dọc X (dài L) + 2 thanh chạy dọc Y (dài W). -->
  <xacro:macro name="rect_ring" params="z L W p">
    <!-- 2 thanh dọc theo X, nằm ở 2 mép Y -->
    <xacro:beam x="0" y="${ (W-p)/2}" z="${z}" sx="${L}" sy="${p}" sz="${p}"/>
    <xacro:beam x="0" y="${-(W-p)/2}" z="${z}" sx="${L}" sy="${p}" sz="${p}"/>
    <!-- 2 thanh dọc theo Y, nằm ở 2 mép X (rút ngắn để không chồng góc) -->
    <xacro:beam x="${ (L-p)/2}" y="0" z="${z}" sx="${p}" sy="${W-2*p}" sz="${p}"/>
    <xacro:beam x="${-(L-p)/2}" y="0" z="${z}" sx="${p}" sy="${W-2*p}" sz="${p}"/>
  </xacro:macro>

  <!-- ===== KHUNG ĐẦY ĐỦ: tầng dưới + tầng trên + 4 cột + 2 thanh giữa ===== -->
  <xacro:macro name="chassis_frame" params="L W H p">
    <!-- vành đáy -->
    <xacro:rect_ring z="${-(H-p)/2}" L="${L}" W="${W}" p="${p}"/>
    <!-- vành nóc -->
    <xacro:rect_ring z="${ (H-p)/2}" L="${L}" W="${W}" p="${p}"/>

    <!-- 4 cột đứng ở 4 góc (dài H) -->
    <xacro:beam x="${ (L-p)/2}" y="${ (W-p)/2}" z="0" sx="${p}" sy="${p}" sz="${H-2*p}"/>
    <xacro:beam x="${ (L-p)/2}" y="${-(W-p)/2}" z="0" sx="${p}" sy="${p}" sz="${H-2*p}"/>
    <xacro:beam x="${-(L-p)/2}" y="${ (W-p)/2}" z="0" sx="${p}" sy="${p}" sz="${H-2*p}"/>
    <xacro:beam x="${-(L-p)/2}" y="${-(W-p)/2}" z="0" sx="${p}" sy="${p}" sz="${H-2*p}"/>

    <!-- 2 thanh ngang gia cố giữa đáy (chạy theo Y), giống các thanh đỡ motor -->
    <xacro:beam x="${ L/6}" y="0" z="${-(H-p)/2}" sx="${p}" sy="${W-2*p}" sz="${p}"/>
    <xacro:beam x="${-L/6}" y="0" z="${-(H-p)/2}" sx="${p}" sy="${W-2*p}" sz="${p}"/>

    <!-- 1 tấm đáy mỏng tượng trưng cho mặt sàn lắp thiết bị (mờ, mỏng) -->
    <visual>
      <origin xyz="0 0 ${-(H-p)/2 + p}" rpy="0 0 0"/>
      <geometry><box size="${L-2*p} ${W-2*p} ${p/3}"/></geometry>
      <material name="dark_grey"/>
    </visual>
  </xacro:macro>

</robot>
