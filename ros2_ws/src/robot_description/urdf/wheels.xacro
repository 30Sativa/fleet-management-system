<?xml version="1.0"?>
<!-- =========================================================================
     wheels.xacro
     Macro cho bánh chính (driven, continuous joint) và caster (bi cầu, fixed
     vì bi lăn tự do trong sim — không cần joint quay riêng cho bi cầu).
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== BÁNH CHÍNH (có motor) ===== -->
  <!-- prefix: left/right ; reflect: +1 (trái) / -1 (phải) -->
  <xacro:macro name="drive_wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <!-- cylinder mặc định trục theo Z; xoay 90° quanh X để trục về Y -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <!-- inertia của cylinder; vì link sẽ quay quanh Y nên dùng macro chuẩn -->
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <!-- joint quay liên tục quanh trục Y của bánh -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <!-- đặt bánh sát hông: y = +/- wheel_separation/2 ; z = xuống tới tâm trục -->
      <origin xyz="${wheel_xoff} ${reflect * wheel_separation/2} ${-base_height/2}"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="100.0" velocity="20.0"/>
      <dynamics damping="0.05" friction="0.1"/>
    </joint>

    <!-- thuộc tính Gazebo cho bánh: ma sát cao để không trượt -->
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <!-- ===== CASTER (bi cầu, tự do) ===== -->
  <!-- prefix: vd front_left ; xpos/ypos: dấu của offset X/Y -->
  <xacro:macro name="caster_wheel" params="prefix xpos ypos">
    <link name="${prefix}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </link>

    <!-- fixed joint: bi cầu lăn tự do nhờ ma sát thấp (mu≈0), không cần motor/joint quay -->
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${prefix}_caster_link"/>
      <origin xyz="${xpos * caster_xoff} ${ypos * caster_yoff} ${caster_zoff}" rpy="0 0 0"/>
    </joint>

    <!-- ma sát ~0 để bi trượt/lăn mọi hướng như caster thật -->
    <gazebo reference="${prefix}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

</robot>
