<?xml version="1.0"?>
<!-- =========================================================================
     robot.urdf.xacro  FILE CHINH (top-level)
     AMR differential-drive: 2 banh chinh co motor + 4 banh phu tu do.
     Cay frame chuan Nav2:
       base_footprint -> base_link -> (wheels, casters, lidar, imu)
     Build: xacro robot.urdf.xacro use_sim:=true > robot.urdf
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr_robot">

  <!-- true = chay Gazebo ; false = hardware that -->
  <xacro:arg name="use_sim" default="true"/>

  <!-- ===== Include cac phan ===== -->
  <xacro:include filename="$(find robot_description)/urdf/common_properties.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/wheels.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/sensors.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/ros2_control.xacro"/>

  <!-- ===== base_footprint (cho Nav2/odom) ===== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===== base_link (than xe) ===== -->
  <link name="base_link">
    <!-- Mesh goc tu CAD; scale mm -> m va doi truc CAD -> ROS. -->
    <visual>
      <origin xyz="-1.674842 -0.764810 -1.092814" rpy="${cad_to_ros_rpy}"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/chassis.stl"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
      <material name="grey"/>
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
    </collision>

    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ===== Banh chinh ===== -->
  <xacro:drive_wheel prefix="left"  reflect="1"
                     mesh_file="left_drive_wheel.stl"
                     mesh_x="-1.674844" mesh_y="-0.981060" mesh_z="-0.985314"/>
  <xacro:drive_wheel prefix="right" reflect="-1"
                     mesh_file="right_drive_wheel.stl"
                     mesh_x="-1.674844" mesh_y="-0.548560" mesh_z="-0.985314"/>

  <!-- ===== 4 banh phu o 4 goc ===== -->
  <xacro:caster_wheel prefix="front_left" xpos="${caster_front_x}" ypos="${caster_left_y}"
                       mesh_file="front_left_caster.stl"
                       mesh_x="-1.964838" mesh_y="-0.917062" mesh_z="-0.974809"/>
  <xacro:caster_wheel prefix="front_right" xpos="${caster_front_x}" ypos="${caster_right_y}"
                       mesh_file="front_right_caster.stl"
                       mesh_x="-1.964857" mesh_y="-0.642145" mesh_z="-0.974809"/>
  <xacro:caster_wheel prefix="rear_left" xpos="${caster_rear_x}" ypos="${caster_left_y}"
                       mesh_file="rear_left_caster.stl"
                       mesh_x="-1.384831" mesh_y="-0.917062" mesh_z="-0.974809"/>
  <xacro:caster_wheel prefix="rear_right" xpos="${caster_rear_x}" ypos="${caster_right_y}"
                       mesh_file="rear_right_caster.stl"
                       mesh_x="-1.384831" mesh_y="-0.642062" mesh_z="-0.974809"/>

  <!-- ===== ros2_control ===== -->
  <xacro:robot_ros2_control use_sim="$(arg use_sim)"/>

</robot>
