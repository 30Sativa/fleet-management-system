<?xml version="1.0"?>
<!-- =========================================================================
     robot.urdf.xacro  FILE CHINH (top-level)
     AMR differential-drive: 2 banh chinh co motor + 4 caster bi cau tu do.
     Cay frame chuan Nav2:
       base_footprint -> base_link -> (wheels, casters, lidar, imu)
     Build: xacro robot.urdf.xacro use_sim:=true > robot.urdf
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr_robot">

  <!-- true = chay Gazebo ; false = hardware that -->
  <xacro:arg name="use_sim" default="true"/>

  <!-- ===== Include cac phan ===== -->
  <xacro:include filename="$(find robot_description)/urdf/common_properties.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/chassis_frame.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/wheels.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/sensors.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/ros2_control.xacro"/>

  <!-- ===== base_footprint (cho Nav2/odom) ===== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===== base_link (than xe) ===== -->
  <link name="base_link">
    <!-- VISUAL = khung nhom ho (nhieu thanh box), nhin giong xe that -->
    <xacro:chassis_frame L="${base_length}" W="${base_width}" H="${base_height}" p="${profile_size}"/>

    <!-- COLLISION = 1 khoi hop bao ngoai (don gian, nhe, an toan cho Nav2). -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ===== Banh chinh ===== -->
  <xacro:drive_wheel prefix="left"  reflect="1"/>
  <xacro:drive_wheel prefix="right" reflect="-1"/>

  <!-- ===== 4 caster o 4 goc ===== -->
  <xacro:caster_wheel prefix="front_left"  xpos="1"  ypos="1"/>
  <xacro:caster_wheel prefix="front_right" xpos="1"  ypos="-1"/>
  <xacro:caster_wheel prefix="rear_left"   xpos="-1" ypos="1"/>
  <xacro:caster_wheel prefix="rear_right"  xpos="-1" ypos="-1"/>

  <!-- ===== ros2_control ===== -->
  <xacro:robot_ros2_control use_sim="$(arg use_sim)"/>

</robot>
