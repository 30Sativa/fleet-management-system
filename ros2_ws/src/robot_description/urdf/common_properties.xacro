<?xml version="1.0"?>
<!-- =========================================================================
     common_properties.xacro
     Tat ca thong so kich thuoc / khoi luong GOM O DAY.
     Muon doi xe -> chi sua file nay. Don vi: met (m), kg, rad (SI chuan ROS).
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== THAN XE (base / chassis) ===== -->
  <!-- Kich thuoc that: Dai 0.74 x Rong 0.55 x Cao 0.34 (m) -->
  <xacro:property name="base_length" value="0.74"/>   <!-- truc X (toi/lui) -->
  <xacro:property name="base_width"  value="0.55"/>   <!-- truc Y (trai/phai) -->
  <xacro:property name="base_height" value="0.34"/>   <!-- truc Z (cao) -->
  <xacro:property name="base_mass"   value="40.0"/>   <!-- UOC LUONG: doi theo can that -->

  <!-- Co thanh nhom dinh hinh (extrusion). Mac dinh 2020 = 0.02m.
       Do lai thanh that roi doi dung 1 so nay (vd 4040 -> 0.04). -->
  <xacro:property name="profile_size" value="0.02"/>

  <!-- ===== BANH CHINH (driven wheels) ===== -->
  <!-- Banh do tren-xuong 0.20m => duong kinh 0.20 => ban kinh 0.10 -->
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width"  value="0.05"/>
  <xacro:property name="wheel_mass"   value="2.0"/>

  <!-- Khoang cach giua 2 banh chinh (track / wheel separation), tam-toi-tam.
       separation = base_width + wheel_width = 0.55 + 0.05 = 0.60.
       RAT QUAN TRONG cho odometry/diff_drive. -->
  <xacro:property name="wheel_separation" value="${base_width + wheel_width}"/>

  <!-- Banh chinh nam GIUA than theo truc X (diff-drive co dien) -->
  <xacro:property name="wheel_xoff" value="0.0"/>

  <!-- ===== BANH PHU (caster, xoay tu do) ===== -->
  <!-- Dung bi cau (sphere): don gian, khong motor, lan moi huong. -->
  <xacro:property name="caster_radius" value="0.05"/>
  <xacro:property name="caster_mass"   value="0.5"/>
  <xacro:property name="caster_xoff" value="${base_length/2 - 0.08}"/>
  <xacro:property name="caster_yoff" value="${base_width/2 - 0.08}"/>

  <!-- ===== CHIEU CAO LAP DAT ===== -->
  <!-- Day banh chinh cham dat (z=0). Tam truc banh o z = wheel_radius.
       Tam bi caster o z = caster_radius. -->
  <xacro:property name="base_z" value="${wheel_radius + base_height/2}"/>
  <xacro:property name="caster_zoff" value="${-(base_height/2 + (wheel_radius - caster_radius))}"/>

  <!-- ===== INERTIA MACROS ===== -->
  <!-- Khoi hop dac -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(m/12.0)*(y*y + z*z)}" ixy="0.0" ixz="0.0"
        iyy="${(m/12.0)*(x*x + z*z)}" iyz="0.0"
        izz="${(m/12.0)*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Khoi tru dac -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(m/12.0)*(3*r*r + h*h)}" ixy="0.0" ixz="0.0"
        iyy="${(m/12.0)*(3*r*r + h*h)}" iyz="0.0"
        izz="${(m/2.0)*(r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- Khoi cau dac -->
  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(2.0/5.0)*m*r*r}" ixy="0.0" ixz="0.0"
        iyy="${(2.0/5.0)*m*r*r}" iyz="0.0"
        izz="${(2.0/5.0)*m*r*r}"/>
    </inertial>
  </xacro:macro>

</robot>
