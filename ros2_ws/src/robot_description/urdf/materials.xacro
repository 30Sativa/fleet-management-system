<?xml version="1.0"?>
<!-- Màu sắc cho RViz (tag <material> trong <visual>) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="grey">   <color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="orange"> <color rgba="0.9 0.5 0.1 1.0"/></material>
  <material name="black">  <color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="blue">   <color rgba="0.1 0.3 0.8 1.0"/></material>
  <material name="white">  <color rgba="0.9 0.9 0.9 1.0"/></material>
</robot>
