<?xml version="1.0"?>
<!-- =========================================================================
     arm_standalone.urdf.xacro
     File TOP-LEVEL de xem RIENG tay trong RViz (chua gan len xe).
     Tao 1 link goc "arm_world" roi goi macro scara_arm gan vao do.
     Build: xacro arm_standalone.urdf.xacro > arm.urdf
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scara_arm_standalone">

  <xacro:include filename="$(find arm_description)/urdf/arm.xacro"/>

  <!-- goc the gioi de RViz co fixed frame -->
  <link name="arm_world"/>

  <!-- goi macro tay, gan vao arm_world (test rieng) -->
  <xacro:scara_arm parent="arm_world" xyz="0 0 0" rpy="0 0 0"/>

</robot>
