<?xml version="1.0"?>
<!-- =========================================================================
     arm.xacro
     Tay robot SCARA (4 DOF): J1 vai + J2 khuyu + Z nang/ha + gripper kep.
     Don vi: met, kg, rad. Macro doc lap, parent gan tuy y.
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scara_arm">

  <!-- ===== Thong so tay (so do that cua Duy) ===== -->
  <xacro:property name="arm_mount_z"  value="0.65"/>
  <xacro:property name="link1_len"    value="0.30"/>
  <xacro:property name="link2_len"    value="0.20"/>
  <xacro:property name="link_thick"   value="0.05"/>
  <xacro:property name="z_travel"     value="0.40"/>
  <xacro:property name="arm_mass"     value="0.5"/>
  <xacro:property name="grip_open"    value="0.20"/>
  <xacro:property name="finger_len"   value="0.06"/>
  <xacro:property name="finger_thick" value="0.02"/>

  <xacro:macro name="arm_box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12.0)*(y*y+z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12.0)*(x*x+z*z)}" iyz="0.0"
               izz="${(m/12.0)*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <material name="arm_blue"><color rgba="0.15 0.35 0.85 1.0"/></material>
  <material name="arm_white"><color rgba="0.95 0.95 0.95 1.0"/></material>

  <xacro:macro name="scara_arm" params="parent xyz:='0 0 0' rpy:='0 0 0'">

    <link name="arm_base_link">
      <visual>
        <origin xyz="0 0 ${arm_mount_z/2}" rpy="0 0 0"/>
        <geometry><box size="0.08 0.08 ${arm_mount_z}"/></geometry>
        <material name="arm_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${arm_mount_z/2}" rpy="0 0 0"/>
        <geometry><box size="0.08 0.08 ${arm_mount_z}"/></geometry>
      </collision>
      <xacro:arm_box_inertia m="${arm_mass}" x="0.08" y="0.08" z="${arm_mount_z}"/>
    </link>

    <joint name="arm_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="arm_base_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="arm_z_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.06 0.06 0.05"/></geometry>
        <material name="arm_blue"/>
      </visual>
      <xacro:arm_box_inertia m="0.2" x="0.06" y="0.06" z="0.05"/>
    </link>
    <joint name="J_z" type="prismatic">
      <parent link="arm_base_link"/>
      <child link="arm_z_link"/>
      <origin xyz="0 0 ${arm_mount_z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-z_travel}" upper="0.0" effort="50.0" velocity="0.1"/>
    </joint>

    <link name="arm_link1">
      <visual>
        <origin xyz="${link1_len/2} 0 0" rpy="0 0 0"/>
        <geometry><box size="${link1_len} ${link_thick} ${link_thick}"/></geometry>
        <material name="arm_blue"/>
      </visual>
      <xacro:arm_box_inertia m="0.3" x="${link1_len}" y="${link_thick}" z="${link_thick}"/>
    </link>
    <joint name="J1" type="revolute">
      <parent link="arm_z_link"/>
      <child link="arm_link1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi}" upper="${pi}" effort="10.0" velocity="2.0"/>
    </joint>

    <link name="arm_link2">
      <visual>
        <origin xyz="${link2_len/2} 0 0" rpy="0 0 0"/>
        <geometry><box size="${link2_len} ${link_thick} ${link_thick}"/></geometry>
        <material name="arm_blue"/>
      </visual>
      <xacro:arm_box_inertia m="0.2" x="${link2_len}" y="${link_thick}" z="${link_thick}"/>
    </link>
    <joint name="J2" type="revolute">
      <parent link="arm_link1"/>
      <child link="arm_link2"/>
      <origin xyz="${link1_len} 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi}" upper="${pi}" effort="10.0" velocity="2.0"/>
    </joint>

    <link name="arm_gripper_base">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.04 ${grip_open} 0.03"/></geometry>
        <material name="arm_white"/>
      </visual>
      <xacro:arm_box_inertia m="0.1" x="0.04" y="${grip_open}" z="0.03"/>
    </link>
    <joint name="J_grip_mount" type="fixed">
      <parent link="arm_link2"/>
      <child link="arm_gripper_base"/>
      <origin xyz="${link2_len} 0 0" rpy="0 0 0"/>
    </joint>

    <link name="arm_finger_left">
      <visual>
        <origin xyz="${finger_len/2} 0 0" rpy="0 0 0"/>
        <geometry><box size="${finger_len} ${finger_thick} 0.03"/></geometry>
        <material name="arm_white"/>
      </visual>
      <xacro:arm_box_inertia m="0.03" x="${finger_len}" y="${finger_thick}" z="0.03"/>
    </link>
    <joint name="J_grip" type="prismatic">
      <parent link="arm_gripper_base"/>
      <child link="arm_finger_left"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="${grip_open/2}" effort="20.0" velocity="0.1"/>
    </joint>

    <link name="arm_finger_right">
      <visual>
        <origin xyz="${finger_len/2} 0 0" rpy="0 0 0"/>
        <geometry><box size="${finger_len} ${finger_thick} 0.03"/></geometry>
        <material name="arm_white"/>
      </visual>
      <xacro:arm_box_inertia m="0.03" x="${finger_len}" y="${finger_thick}" z="0.03"/>
    </link>
    <joint name="J_grip_mirror" type="prismatic">
      <parent link="arm_gripper_base"/>
      <child link="arm_finger_right"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <mimic joint="J_grip" multiplier="1.0" offset="0.0"/>
      <limit lower="0.0" upper="${grip_open/2}" effort="20.0" velocity="0.1"/>
    </joint>

  </xacro:macro>

</robot>
