Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /LaserScan1
      Splitter Ratio: 0.55
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 120; 120; 120
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Alpha: 0.75
      Color Scheme: map
      Draw Behind: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
      Color: 255; 32; 32
      Position Transformer: XYZ
      Value: true
    - Class: rviz_default_plugins/Range
      Name: Front SR04T
      Enabled: true
      Topic:
        Value: /ultrasonic/sonar1/range
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Color: 0; 220; 80
      Alpha: 0.45
      Buffer Length: 1
      Value: true
    - Class: rviz_default_plugins/Range
      Name: Rear SR04T
      Enabled: true
      Topic:
        Value: /ultrasonic/sonar2/range
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Color: 255; 210; 0
      Alpha: 0.45
      Buffer Length: 1
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.25
      Frame Timeout: 15
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Camera Depth Cloud
      Enabled: true
      Topic:
        Value: /camera/depth/points
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Alpha: 0.65
      Decay Time: 0
      Color Transformer: AxisColor
      Axis: Z
      Position Transformer: XYZ
      Selectable: true
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: RGB Camera
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Depth Image
      Enabled: true
      Topic:
        Value: /camera/depth/image_raw
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Normalize Range: true
      Min Value: 0
      Max Value: 1
      Value: true
  Global Options:
    Background Color: 38; 38; 42
    Fixed Frame: map
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 255; 255; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Mapping View
      Angle: 0
      Scale: 35
      X: 0
      Y: 0
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1440
  Hide Left Dock: false
  Hide Right Dock: true
