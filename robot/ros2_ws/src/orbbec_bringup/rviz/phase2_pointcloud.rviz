Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /DepthCloud1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: GroundPlaneZ0
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Plane: XY
      Offset:
        X: 0
        Y: 0
        Z: 0
      Color: 200; 200; 200
      Alpha: 0.5
      Line Style: Lines
      Reference Frame: base_link
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: BaseLink
      Enabled: true
      Reference Frame: base_link
      Length: 0.3
      Radius: 0.02
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.25
      Update Interval: 0
      Frame Timeout: 15
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: DepthCloud
      Enabled: true
      Topic:
        Value: /camera/depth/points
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: false
      Min Value: -0.1
      Max Value: 1.2
      Use Fixed Frame: true
      Use rainbow: true
      Invert Rainbow: false
      Selectable: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: DepthImage
      Enabled: true
      Topic:
        Value: /camera/depth/image_raw
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Max Value: 1
      Min Value: 0
      Normalize Range: true
      Value: true
  Global Options:
    Background Color: 38; 38; 38
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 255; 200; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: SideView
      Distance: 4
      Focal Point:
        X: 1.2
        Y: 0
        Z: 0.2
      Pitch: 0.05
      Yaw: 3.05
      Near Clip Distance: 0.01
      Target Frame: base_link
      Value: Orbit (rviz)
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: TopDown
        Distance: 5
        Focal Point:
          X: 1.5
          Y: 0
          Z: 0
        Pitch: 1.5697
        Yaw: 3.1415
        Near Clip Distance: 0.01
        Target Frame: base_link
        Value: Orbit (rviz)
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
  Hide Left Dock: false
  Hide Right Dock: true
