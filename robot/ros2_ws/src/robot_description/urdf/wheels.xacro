<?xml version="1.0"?>
<!-- =========================================================================
     wheels.xacro
     Macro cho bánh chính (driven, continuous joint) và 4 bánh phụ.
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== BÁNH CHÍNH (có motor) ===== -->
  <!-- prefix: left/right ; reflect: +1 (trái) / -1 (phải) -->
  <xacro:macro name="drive_wheel" params="prefix reflect mesh_file mesh_x mesh_y mesh_z">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="${mesh_x} ${mesh_y} ${mesh_z}" rpy="${cad_to_ros_rpy}"/>
        <geometry>
          <mesh filename="package://robot_description/meshes/${mesh_file}"
                scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <!-- Collision = cylinder (truc quay quanh Y). Nhanh hon mesh nhieu. -->
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <!-- inertia của cylinder; vì link sẽ quay quanh Y nên dùng macro chuẩn -->
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <!-- joint quay liên tục quanh trục Y của bánh -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <!-- Vi tri tam banh lay tu CAD -->
      <origin xyz="${wheel_xoff} ${reflect * wheel_separation/2} ${wheel_zoff}"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="100.0" velocity="20.0"/>
      <dynamics damping="0.05" friction="0.1"/>
    </joint>

    <!-- thuộc tính Gazebo cho bánh: ma sát cao để không trượt -->
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <!-- ===== BANH PHU ===== -->
  <!-- Hinh dang lay tu STL; co cau swivel chua duoc mo phong. -->
  <xacro:macro name="caster_wheel" params="prefix xpos ypos mesh_file mesh_x mesh_y mesh_z">
    <link name="${prefix}_caster_link">
      <visual>
        <origin xyz="${mesh_x} ${mesh_y} ${mesh_z}" rpy="${cad_to_ros_rpy}"/>
        <geometry>
          <mesh filename="package://robot_description/meshes/${mesh_file}"
                scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <!-- Collision = sphere don gian thay cho mesh phu. -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </link>

    <!-- fixed joint: chi mo phong hinh dang va tiep xuc, chua co swivel joint -->
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${prefix}_caster_link"/>
      <origin xyz="${xpos} ${ypos} ${caster_zoff}" rpy="0 0 0"/>
    </joint>

    <!-- Ma sat thap de banh phu khong keo le robot qua nhieu. -->
    <gazebo reference="${prefix}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

</robot>
