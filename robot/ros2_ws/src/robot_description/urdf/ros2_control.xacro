<?xml version="1.0"?>
<!-- =========================================================================
     ros2_control.xacro
     Khai bao hardware interface cho 2 banh chinh.
     use_sim=true  -> Gazebo (gazebo_ros2_control/GazeboSystem)
     use_sim=false -> hardware that (doi plugin driver cua ban)
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="robot_ros2_control" params="use_sim">
    <ros2_control name="AMRSystem" type="system">

      <hardware>
        <xacro:if value="${use_sim}">
          <!-- ===== MO PHONG (Gazebo Classic) ===== -->
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_sim}">
          <!-- ===== HARDWARE THAT: doi plugin nay thanh driver that cua ban ===== -->
          <plugin>diffdrive_arduino/DiffDriveArduinoHardware</plugin>
          <param name="left_wheel_name">left_wheel_joint</param>
          <param name="right_wheel_name">right_wheel_joint</param>
          <param name="device">/dev/ttyUSB0</param>
          <param name="baud_rate">57600</param>
          <param name="timeout_ms">1000</param>
          <param name="enc_counts_per_rev">3436</param>
        </xacro:unless>
      </hardware>

      <!-- Banh trai -->
      <joint name="left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-20.0</param>
          <param name="max">20.0</param>
        </command_interface>
        <state_interface name="velocity"/>
        <state_interface name="position"/>
      </joint>

      <!-- Banh phai -->
      <joint name="right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-20.0</param>
          <param name="max">20.0</param>
        </command_interface>
        <state_interface name="velocity"/>
        <state_interface name="position"/>
      </joint>

    </ros2_control>

    <!-- Plugin gazebo_ros2_control: nap controller_manager + doc URDF + YAML.
         robot_param + robot_param_node giup plugin LAY URDF tu
         robot_state_publisher qua topic, thay vi tu day param robot_description
         (cai do gay loi parse param override rule). -->
    <xacro:if value="${use_sim}">
      <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
          <robot_param>robot_description</robot_param>
          <robot_param_node>robot_state_publisher</robot_param_node>
          <parameters>$(find robot_description)/config/diff_drive_controller.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
