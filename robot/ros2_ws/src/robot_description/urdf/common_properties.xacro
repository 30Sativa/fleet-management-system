<?xml version="1.0"?>
<!-- =========================================================================
     common_properties.xacro
     Tat ca thong so kich thuoc / khoi luong GOM O DAY.
     Muon doi xe -> chi sua file nay. Don vi: met (m), kg, rad (SI chuan ROS).
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== THAN XE (base / chassis) ===== -->
  <!-- Bao ngoai 28 mesh than xe, khong tinh banh, LiDAR va camera (m). -->
  <xacro:property name="base_length" value="0.802199951"/>  <!-- truc X (toi/lui) -->
  <xacro:property name="base_width"  value="0.562799988"/>  <!-- truc Y (trai/phai) -->
  <xacro:property name="base_height" value="0.421100037"/>  <!-- truc Z (cao) -->
  <xacro:property name="base_mass"   value="40.0"/>   <!-- UOC LUONG: doi theo can that -->

  <!-- ===== CAD mesh transform ===== -->
  <!-- STL dung mm va truc CAD: X=trai/phai, Y=cao, Z=truoc/sau.
       ROS: X=truoc, Y=trai, Z=cao. -->
  <xacro:property name="mesh_scale" value="0.001"/>
  <xacro:property name="cad_to_ros_rpy" value="1.57079632679 0 1.57079632679"/>

  <!-- Moi body STL duoc export trong cung toa do assembly. Origin nay dat
       tam khung CAD tai base_link; khong can offset rieng cho tung part. -->
  <xacro:property name="body_mesh_origin" value="-1.638492310 -0.744854355 -1.164497711"/>

  <!-- Tam box bao ngoai lech khoi tam khung vi vo xe khong doi xung. -->
  <xacro:property name="base_collision_x" value="0.0"/>
  <xacro:property name="base_collision_y" value="0.000049973"/>
  <xacro:property name="base_collision_z" value="0.056"/>

  <xacro:macro name="body_visual" params="mesh_file material:=grey">
    <visual>
      <origin xyz="${body_mesh_origin}" rpy="${cad_to_ros_rpy}"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/${mesh_file}"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <!-- Phu kien giu toa do assembly nhung khong tham gia tinh body envelope. -->
  <xacro:macro name="assembly_visual" params="mesh_file material:=grey">
    <visual>
      <origin xyz="${body_mesh_origin}" rpy="${cad_to_ros_rpy}"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/${mesh_file}"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <!-- ===== BANH CHINH (driven wheels) ===== -->
  <!-- Do tu drive-wheel STL: duong kinh xap xi 0.1945m, day 0.050m. -->
  <xacro:property name="wheel_radius" value="0.09725"/>
  <xacro:property name="wheel_width"  value="0.05"/>
  <xacro:property name="wheel_mass"   value="2.0"/>

  <!-- Khoang cach tam-tam do truc CAD: 981.06 - 548.56 = 432.50mm. -->
  <xacro:property name="wheel_separation" value="0.4325"/>

  <!-- Vi tri tam banh so voi tam base_link, lay tu CAD. -->
  <xacro:property name="wheel_xoff" value="0.0"/>
  <xacro:property name="wheel_zoff" value="-0.10955"/>

  <!-- ===== BANH PHU ===== -->
  <!-- Kich thuoc STL phu khoang 0.169 x 0.171m. -->
  <xacro:property name="caster_radius" value="0.0855"/>
  <xacro:property name="caster_mass"   value="0.5"/>
  <!-- Vi tri 4 banh phu do tu tam mesh, giu dung CAD. -->
  <xacro:property name="caster_front_x" value="0.2900"/>
  <xacro:property name="caster_rear_x"  value="-0.2900"/>
  <xacro:property name="caster_left_y"  value="0.15225"/>
  <xacro:property name="caster_right_y" value="-0.12275"/>
  <!-- Ha xuong de banh phu CHAM DAT (day = day banh chinh) -> robot dung vung,
       khong lat. caster_zoff = caster_radius - base_z = 0.0855 - 0.2068. -->
  <xacro:property name="caster_zoff" value="-0.1213"/>

  <!-- ===== CHIEU CAO LAP DAT ===== -->
  <!-- Base_link la tam khung. Dat theo day banh chinh trong CAD. -->
  <xacro:property name="base_z" value="0.2068"/>

  <!-- ===== INERTIA MACROS ===== -->
  <!-- Khoi hop dac -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(m/12.0)*(y*y + z*z)}" ixy="0.0" ixz="0.0"
        iyy="${(m/12.0)*(x*x + z*z)}" iyz="0.0"
        izz="${(m/12.0)*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Khoi tru dac -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(m/12.0)*(3*r*r + h*h)}" ixy="0.0" ixz="0.0"
        iyy="${(m/12.0)*(3*r*r + h*h)}" iyz="0.0"
        izz="${(m/2.0)*(r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- Khoi cau dac -->
  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(2.0/5.0)*m*r*r}" ixy="0.0" ixz="0.0"
        iyy="${(2.0/5.0)*m*r*r}" iyz="0.0"
        izz="${(2.0/5.0)*m*r*r}"/>
    </inertial>
  </xacro:macro>

</robot>
