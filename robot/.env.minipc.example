# MiniPC hardware environment
# Copy:
#   cp .env.minipc.example .env
#
# Start:
#   docker compose --profile hardware up -d

# Docker image dùng cho robot thật
DOCKER_IMAGE=307sativa/robot-ros2:latest

# ROS 2 networking
ROS_DOMAIN_ID=30
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_LOCALHOST_ONLY=0

# Fast DDS Discovery Server chạy ngay trên MiniPC.
# Không phụ thuộc Wi-Fi, DHCP hay IP LAN.
ROS_DISCOVERY_SERVER=127.0.0.1:11811

# Hardware
SERIAL_PORT=/dev/ttyACM0
BAUDRATE=115200
LIDAR_PORT=/dev/ttyUSB0

# Joystick tạm thời chưa dùng
# JOY_DEV=/dev/input/js0
