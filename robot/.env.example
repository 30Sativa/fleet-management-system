# Copy this file to ".env" (same folder as docker-compose.yml) on EACH machine
# (miniPC and the Ubuntu VMware guest). ".env" is git-ignored on purpose
# — never commit it.
#
#   cp .env.example .env
#   nano .env
#
#   miniPC : docker compose --profile hardware up -d
#   VMware : docker compose --profile debug    up -d

# Image dùng cho service hardware trên miniPC. Phải khớp image mà GitHub Actions
# đã build/push (.github/workflows/docker-build-push.yml -> secrets.DOCKERHUB_USERNAME).
# Service debug trên VMware KHÔNG dùng biến này (nó build local ra robot-ros2:dev).
DOCKER_IMAGE=307sativa/robot-ros2:latest

# ---------------------------------------------------------------------------
# ROS 2 networking — PHẢI GIỐNG NHAU trên miniPC và VMware, nếu không VMware sẽ
# không thấy topic nào.
# ---------------------------------------------------------------------------
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Fast DDS Discovery Server.
#
# TRONG DỰ ÁN NÀY BIẾN NÀY LÀ BẮT BUỘC. LAN đang dùng chặn UDP multicast
# (xem docs/network-ros-discovery.md), nên DDS discovery mặc định KHÔNG hoạt động
# giữa miniPC và VM. Nếu để trống, VMware chỉ thấy /rosout + /parameter_events.
#
# miniPC phải đang chạy discovery server:
#   systemctl status fastdds-discovery.service
#
# Cả hai máy set CÙNG một giá trị = IP LAN của miniPC (đổi cho khớp mạng của bạn):
ROS_DISCOVERY_SERVER=192.168.1.87:11811

# ---------------------------------------------------------------------------
# Chỉ dùng cho profile `hardware` trên miniPC. VMware bỏ qua hoàn toàn.
# ---------------------------------------------------------------------------
# SERIAL_PORT=/dev/ttyACM0
# BAUDRATE=115200
# LIDAR_PORT=/dev/ttyUSB0
# JOY_DEV=/dev/input/js0

# GUI cho profile `debug` trên VMware (thường không cần sửa).
# DISPLAY=:0
# LIBGL_ALWAYS_SOFTWARE=1
