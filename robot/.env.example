# Copy this file to ".env" (same folder as docker-compose.yml) on the miniPC
# and fill in your real Docker Hub username. ".env" is git-ignored on purpose
# — never commit it.
#
#   cp .env.example .env
#   nano .env    # edit DOCKER_IMAGE below
#   docker compose up -d

# Must match the image GitHub Actions built and pushed
# (.github/workflows/docker-build-push.yml -> secrets.DOCKERHUB_USERNAME).
DOCKER_IMAGE=<dockerhub-username>/robot-ros2:latest

# Uncomment and adjust only if your setup differs from the defaults already
# baked into docker-compose.yml.
# ROS_DOMAIN_ID=0
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# SERIAL_PORT=/dev/ttyACM0
# BAUDRATE=115200
# LIDAR_PORT=/dev/ttyUSB0
