name: Build and Push ROS2 Docker Image

on:
  pull_request:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

env:
  ROS_DISTRO: humble
  DOCKER_IMAGE: dockerhub-username/robot-ros2

jobs:
  docker:
    name: Build ROS2 Docker image
    runs-on: ubuntu-latest
    permissions:
      contents: read

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Compute image tags
        id: tags
        shell: bash
        run: |
          echo "short_sha=${GITHUB_SHA::7}" >> "$GITHUB_OUTPUT"

      - name: Resolve Docker image name
        id: image
        shell: bash
        env:
          DOCKERHUB_USERNAME: ${{ secrets.DOCKERHUB_USERNAME }}
        run: |
          image="${DOCKER_IMAGE}"
          if [ "${image}" = "dockerhub-username/robot-ros2" ] && [ -n "${DOCKERHUB_USERNAME}" ]; then
            image="${DOCKERHUB_USERNAME}/robot-ros2"
          fi
          echo "image=${image}" >> "$GITHUB_OUTPUT"

      - name: Login to Docker Hub
        if: github.event_name == 'push'
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Build image on PR, build and push on main/master
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./Dockerfile
          build-args: |
            ROS_DISTRO=${{ env.ROS_DISTRO }}
          push: ${{ github.event_name == 'push' }}
          tags: |
            ${{ steps.image.outputs.image }}:latest
            ${{ steps.image.outputs.image }}:${{ steps.tags.outputs.short_sha }}
